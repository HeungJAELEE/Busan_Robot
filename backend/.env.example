# Indy7 HMI Docker deployment settings

# MQTT ports exposed on the host
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Prebuilt registry image tag for docker-compose.registry.yml
IMAGE_TAG=latest

# Robot network
ROBOT_A_IP=192.168.3.7
ROBOT_B_IP=192.168.3.6
ROBOT_C_IP=192.168.3.5
ROBOT_NAME=NRMK-Indy7
ROBOT_MODEL=NRMK-Indy7
DEFAULT_ROBOT_ID=Robot A
ROBOT_AUTOCONNECT=0

# Digital Twin WebSocket port
DIGITAL_TWIN_PORT=8080

# PLC network
# PLC가 메인 제어권을 가지며, HMI는 아래 신호를 읽어서 MQTT/DB로 기록합니다.
PLC_IP=192.168.3.150
PLC_PORT=2000
PLC_PROCESS_IP=192.168.3.150
PLC_PROCESS_PORT=2000
PLC_MONITOR_IP=192.168.3.160
PLC_MONITOR_PORT=2000
PLC_SCAN_INTERVAL_SEC=0.1
PLC_PROCESS_START_DEVICE=X11
PLC_PROCESS_STOP_DEVICE=X12
PLC_ROBOT_START_OUTPUT=Y160
ROBOT_START_DI=DI0
PLC_ROBOT_COMPLETE_DEVICE=X145
PLC_DONE_SIGNAL_MAP=PLC150:M1150,PLC130:M1130,PLC120:M1120

# MySQL/MES
MYSQL_HOST=192.168.3.141
MYSQL_PORT=3306
MYSQL_USER=guest
MYSQL_PASSWORD=guest1234
MYSQL_DATABASE=faictory_mes

# Vision container profile
CAMERA_DEVICE=/dev/video0
