# Indy7 HMI Docker deployment settings

# MQTT ports exposed on the host
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Prebuilt registry image tag for docker-compose.registry.yml
IMAGE_TAG=latest

# Robot network
ROBOT_A_IP=192.168.3.7
ROBOT_B_IP=192.168.3.6
ROBOT_C_IP=192.168.3.5
ROBOT_A_PLC_IP=192.168.3.150
ROBOT_B_PLC_IP=192.168.3.140
ROBOT_C_PLC_IP=192.168.3.120
ROBOT_NAME=NRMK-Indy7
ROBOT_MODEL=NRMK-Indy7
DEFAULT_ROBOT_ID=Robot A
ROBOT_AUTOCONNECT=0
ROBOT_CONTROL_MODE=auto
ROBOT_COMMAND_QUEUE_MAXSIZE=200
ROBOT_MOVE_TIMEOUT_SEC=180
ROBOT_MOVE_POLL_SEC=0.05
ROBOT_ACTUAL_JOINT_DELTA_EPS=0.01
ROBOT_ACTUAL_TASK_DELTA_EPS=0.0005

# HMI local UI startup
# 1: UI subscribes to MQTT in the background.
# 0: UI opens first; MQTT starts from robot connect/service action. Safer for beginner/offline startup.
HMI_MQTT_AUTOCONNECT=0
HMI_MQTT_CONNECT_WAIT_SEC=3
FACTORY_ORCHESTRATOR_AUTOSTART=0
FACTORY_ORCHESTRATOR_SIMULATION=0
ROBOT_GATEWAY_CONNECT_TIMEOUT_SEC=8

# Digital Twin WebSocket port
DIGITAL_TWIN_PORT=8080

# PLC network
# PLC가 메인 제어권을 가지며, HMI는 아래 신호를 읽어서 MQTT/DB로 기록합니다.
PLC_IP=192.168.3.150
PLC_PORT=2000
PLC_PROCESS_IP=192.168.3.150
PLC_PROCESS_PORT=2000
PLC_MONITOR_IP=192.168.3.160
PLC_MONITOR_PORT=2000
PLC_SCAN_INTERVAL_SEC=0.1
PLC_PROCESS_START_DEVICE=X11
PLC_PROCESS_STOP_DEVICE=X12
PLC_ROBOT_START_OUTPUT=Y160
ROBOT_START_DI=DI0
PLC_ROBOT_COMPLETE_DEVICE=X145
PLC_DONE_SIGNAL_MAP=PLC150:M1150,PLC130:M1130,PLC120:M1120

# Legacy PC-PLC handshake addresses used only by the old ContyExecutor path.
PLC_CYCLE_START_DEVICE=X11
PLC_ROBOT_BUSY_DEVICE=M200
PLC_CYCLE_COMPLETE_DEVICE=M101
PLC_ACK_DEVICE=M105
PLC_ALARM_DEVICE=M102

# MySQL/MES
MYSQL_HOST=192.168.3.141
MYSQL_PORT=3306
MYSQL_USER=guest
MYSQL_PASSWORD=guest1234
MYSQL_DATABASE=faictory_mes

# Vision container profile
CAMERA_DEVICE=/dev/video0
